# Copy to .env and fill in real values. Never commit .env.
# See README.md (Configuration) for what each key does.

APP_ENV=development
GO_ENV=development
APP_NAME=Pricebase
APP_VERSION=1.0.0
APP_PORT=5025
API_ROUTE=/api
APP_CHANNELS=web,mobile,desktop
AUTH_TYPE=jwt

POSTGRES_URL=postgres://localhost:5432/pricebase?sslmode=disable
POSTGRES_TEST_URL=postgres://localhost:5432/pricebase_test?sslmode=disable

REDIS_URL=redis://localhost:6379
REDIS_CLUSTER=false
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=10

# Consumed by config.ConnectToRedis (host/port/user/password/platform).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_PLATFORM=provisioned

JWT_SECRET=change-me
JWT_EXPIRES=1h
JWT_COOKIE_EXPIRE=1h

SUPERADMIN_EMAIL=super@pricebase.so

EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

CORS_ORIGINS=http://localhost:3000

# Rate limits: windows are milliseconds, matching the TS defaults.
RL_GLOBAL_WINDOW_MS=86400000
RL_GLOBAL_MAX=30000
RL_AUTH_WINDOW_MS=900000
RL_AUTH_MAX=100
RL_LOGIN_WINDOW_MS=900000
RL_LOGIN_MAX=10
RL_PROTECTED_WINDOW_MS=900000
RL_PROTECTED_MAX=300

# Absolute or relative (to repo root) log directory. Defaults to internal/_data/logs.
LOGS_PATH=./internal/_data/logs

# Remote log tailing (optional)
# LOGTAIL_MONITOR_TOKEN=
# LOGTAIL_AUDIT_TOKEN=
# LOGTAIL_INGESTION_URL=
